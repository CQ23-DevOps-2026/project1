def buildDeployPlan() {
    def namespace = dockerNamespace()
    def plan = []

    serviceDefinitions().each { svc ->
        def branch = normalizeBranch(params[svc.param] as String)
        def tag = resolveImageTag(svc.id, branch)

        plan << [
            id: svc.id,
            branch: branch,
            tag: tag,
            chart: svc.chart,
            release: svc.release,
            root: svc.root,
            imageRef: "${namespace}/${svc.image}:${tag}",
            nodePort: svc.nodePortParam ? ((params[svc.nodePortParam] ?: svc.nodePortDefault) as String) : (svc.nodePort ?: '')
        ]
    }

    return plan
}

def helmSetArgs(Map item, String storefrontApiBasePath = '') {
    def root = item.root
    def imageRef = item.imageRef as String
    def repository = imageRef.substring(0, imageRef.lastIndexOf(':'))
    def tag = imageRef.substring(imageRef.lastIndexOf(':') + 1)

    def args = [
        "--set ${root}.image.repository=${repository}",
        "--set ${root}.image.tag=${tag}",
        "--set ${root}.image.pullPolicy=Always"
    ]

    if (item.id == 'storefront') {
        args << "--set ${root}.ingress.enabled=false"
    } else if (item.id == 'backoffice') {
        args << "--set ${root}.ingress.enabled=false"
    } else if (item.id == 'storefront-bff') {
        args << "--set ${root}.ingress.enabled=false"
    } else if (item.id == 'backoffice-bff') {
        args << "--set ${root}.ingress.enabled=false"
    } else {
        args << "--set ${root}.ingress.enabled=false"
    }

    if (item.nodePort) {
        args << "--set ${root}.service.type=NodePort"
        args << "--set ${root}.service.nodePort=${item.nodePort}"
    } else {
        args << "--set ${root}.service.type=ClusterIP"
    }

    if (item.id == 'storefront') {
        args << "--set ${root}.extraEnvs\\[0\\].name=API_BASE_PATH"
        args << "--set-string ${root}.extraEnvs\\[0\\].value=${storefrontApiBasePath}"
    }

    return args.join(' ')
}

pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk   'Java21'
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'WORKER_NODE_HOST', defaultValue: '35.247.188.122', description: 'Public IP/domain of the Kubernetes worker node')
        string(name: 'STOREFRONT_HOST', defaultValue: 'storefront.yas.local.com', description: 'Developer storefront domain')
        string(name: 'BACKOFFICE_HOST', defaultValue: 'backoffice.yas.local.com', description: 'Developer backoffice domain')
        string(name: 'API_HOST', defaultValue: 'api.yas.local.com', description: 'Developer API domain')
        string(name: 'STOREFRONT_NODE_PORT', defaultValue: '31080', description: 'NodePort for storefront-bff')
        string(name: 'BACKOFFICE_NODE_PORT', defaultValue: '31081', description: 'NodePort for backoffice-bff')
        string(name: 'API_NODE_PORT', defaultValue: '31082', description: 'NodePort for api-gateway')
        choice(name: 'DEPLOY_CONCURRENCY', choices: ['2', '1', '3'], description: 'Number of application Helm releases to deploy in parallel')

        string(name: 'BACKOFFICE_BRANCH', defaultValue: 'main', description: 'Branch for backoffice image')
        string(name: 'BACKOFFICE_BFF_BRANCH', defaultValue: 'main', description: 'Branch for backoffice-bff image')
        string(name: 'STOREFRONT_BRANCH', defaultValue: 'main', description: 'Branch for storefront image')
        string(name: 'STOREFRONT_BFF_BRANCH', defaultValue: 'main', description: 'Branch for storefront-bff image')
        string(name: 'API_GATEWAY_BRANCH', defaultValue: 'main', description: 'Branch for api-gateway image')
        string(name: 'CART_BRANCH', defaultValue: 'main', description: 'Branch for cart image')
        string(name: 'CUSTOMER_BRANCH', defaultValue: 'main', description: 'Branch for customer image')
        string(name: 'INVENTORY_BRANCH', defaultValue: 'main', description: 'Branch for inventory image')
        string(name: 'LOCATION_BRANCH', defaultValue: 'main', description: 'Branch for location image')
        string(name: 'MEDIA_BRANCH', defaultValue: 'main', description: 'Branch for media image')
        string(name: 'ORDER_BRANCH', defaultValue: 'main', description: 'Branch for order image')
        string(name: 'PAYMENT_BRANCH', defaultValue: 'main', description: 'Branch for payment image')
        string(name: 'PAYMENT_PAYPAL_BRANCH', defaultValue: 'main', description: 'Branch for payment-paypal image')
        string(name: 'PRODUCT_BRANCH', defaultValue: 'main', description: 'Branch for product image')
        string(name: 'PROMOTION_BRANCH', defaultValue: 'main', description: 'Branch for promotion image')
        string(name: 'RATING_BRANCH', defaultValue: 'main', description: 'Branch for rating image')
        string(name: 'RECOMMENDATION_BRANCH', defaultValue: 'main', description: 'Branch for recommendation image')
        string(name: 'SAMPLEDATA_BRANCH', defaultValue: 'main', description: 'Branch for sampledata image')
        string(name: 'SEARCH_BRANCH', defaultValue: 'main', description: 'Branch for search image')
        string(name: 'TAX_BRANCH', defaultValue: 'main', description: 'Branch for tax image')
        string(name: 'WEBHOOK_BRANCH', defaultValue: 'main', description: 'Branch for webhook image')
    }

    environment {
        DEPLOY_NAMESPACE = 'yas-developer'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Resolve Image Tags') {
            steps {
                script {
                    deployPlan = buildDeployPlan()

                    echo 'Developer deploy plan:'
                    deployPlan.each { item ->
                        echo "- ${item.id}: branch=${item.branch}, image=${item.imageRef}"
                    }
                }
            }
        }

        stage('Verify Docker Images') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )]) {
                        sh '''
                            set -euo pipefail
                            echo "$DOCKERHUB_PASSWORD" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin
                        '''

                        deployPlan.each { item ->
                            sh "docker manifest inspect ${shellQuote(item.imageRef as String)} > /dev/null"
                        }

                        sh 'docker logout || true'
                    }
                }
            }
        }

        stage('Deploy Configuration') {
            steps {
                sh '''
                    set -eu
                    rm -f "${HOME}/.cache/helm/repository/stakater-index.yaml"
                    helm repo add stakater https://stakater.github.io/stakater-charts || true
                    helm repo update
                    helm dependency build k8s/charts/yas-configuration --skip-refresh
                    helm upgrade --install yas-configuration k8s/charts/yas-configuration \
                        --namespace "$DEPLOY_NAMESPACE" --create-namespace \
                        --set mediaApplicationConfig.yas.publicUrl="http://${STOREFRONT_HOST}:${STOREFRONT_NODE_PORT}/api/media"
                '''
            }
        }

        stage('Deploy Applications') {
            steps {
                script {
                    def concurrency = deployConcurrency()
                    echo "=> Developer deploy concurrency: ${concurrency}"

                    deployPlan.collate(concurrency).eachWithIndex { batch, index ->
                        echo "=> Developer deploy batch ${index + 1}: ${batch.collect { it.id }.join(', ')}"

                        def branches = [:]
                        batch.each { planItem ->
                            def item = planItem
                            branches["Deploy: ${item.id}"] = {
                                def chartPath = "k8s/charts/${item.chart}"
                                def release = item.release as String
                                def storefrontApiBasePath = ''
                                if (item.id == 'storefront') {
                                    def storefrontBffClusterIp = sh(
                                        script: "kubectl get svc storefront-bff -n ${shellQuote(env.DEPLOY_NAMESPACE)} -o jsonpath='{.spec.clusterIP}'",
                                        returnStdout: true
                                    ).trim()
                                    if (!storefrontBffClusterIp) {
                                        error 'Cannot resolve storefront-bff ClusterIP for storefront SSR API_BASE_PATH'
                                    }
                                    storefrontApiBasePath = "http://${storefrontBffClusterIp}/api"
                                }
                                def setArgs = helmSetArgs(item as Map, storefrontApiBasePath)

                                sh "helm dependency build ${shellQuote(chartPath)} --skip-refresh"
                                sh "helm upgrade --install ${shellQuote(release)} ${shellQuote(chartPath)} --namespace ${shellQuote(env.DEPLOY_NAMESPACE)} --create-namespace ${setArgs}"
                                sh """
                                    set -euo pipefail
                                    echo "=> Waiting for rolling update of ${release} before continuing"
                                    kubectl rollout status deployment/${shellQuote(release)} -n ${shellQuote(env.DEPLOY_NAMESPACE)} --timeout=360s
                                """
                            }
                        }

                        parallel branches
                    }
                }
            }
        }

        stage('Deploy Swagger UI') {
            steps {
                sh '''
                    set -eu
                    helm dependency build k8s/charts/swagger-ui --skip-refresh || true

                    cat > /tmp/swagger-ui-developer-values.yaml <<EOF
urls: '[{"url":"/api/product/v3/api-docs","name":"Product"},
      {"url":"/api/media/v3/api-docs","name":"Media"},
      {"url":"/api/customer/v3/api-docs","name":"Customer"},
      {"url":"/api/cart/v3/api-docs","name":"Cart"},
      {"url":"/api/rating/v3/api-docs","name":"Rating"},
      {"url":"/api/order/v3/api-docs","name":"Order"},
      {"url":"/api/payment/v3/api-docs","name":"Payment"},
      {"url":"/api/location/v3/api-docs","name":"Location"},
      {"url":"/api/inventory/v3/api-docs","name":"Inventory"},
      {"url":"/api/tax/v3/api-docs","name":"Tax"},
      {"url":"/api/promotion/v3/api-docs","name":"Promotion"},
      {"url":"/api/search/v3/api-docs","name":"Search"}]'
EOF

                    helm upgrade --install swagger-ui k8s/charts/swagger-ui \
                        --namespace "$DEPLOY_NAMESPACE" --create-namespace \
                        -f /tmp/swagger-ui-developer-values.yaml \
                        --set service.type=ClusterIP \
                        --set ingress.enabled=false
                '''
            }
        }

        stage('Rollout Status') {
            steps {
                script {
                    deployPlan.each { item ->
                        sh "kubectl rollout status deployment/${shellQuote(item.release as String)} -n ${shellQuote(env.DEPLOY_NAMESPACE)} --timeout=360s"
                    }
                    sh "kubectl rollout status deployment/swagger-ui -n ${shellQuote(env.DEPLOY_NAMESPACE)} --timeout=360s"
                }
            }
        }

        stage('Access Info') {
            steps {
                sh '''
                    set -eu
                    API_NODE_PORT="${API_NODE_PORT:-31082}"

                    echo "=== Developer namespace pods ==="
                    kubectl get pods -n "$DEPLOY_NAMESPACE" -o wide

                    echo "=== Developer namespace services ==="
                    kubectl get svc -n "$DEPLOY_NAMESPACE" -o wide

                    echo ""
                    echo "Add these entries to the developer machine hosts file:"
                    echo "$WORKER_NODE_HOST $STOREFRONT_HOST"
                    echo "$WORKER_NODE_HOST $BACKOFFICE_HOST"
                    echo "$WORKER_NODE_HOST $API_HOST"

                    echo ""
                    echo "Developer URLs:"
                    echo "Storefront: http://$STOREFRONT_HOST:$STOREFRONT_NODE_PORT"
                    echo "Backoffice:  http://$BACKOFFICE_HOST:$BACKOFFICE_NODE_PORT"
                    echo ""
                    echo "Example API through api-gateway:"
                    echo "http://$API_HOST:$API_NODE_PORT/api/product/storefront/products/featured?pageNo=0"
                    echo "Swagger UI: http://$API_HOST:$API_NODE_PORT/swagger-ui/"
                '''

                script {
                    def storefrontUrl = "http://${params.STOREFRONT_HOST}:${params.STOREFRONT_NODE_PORT}"
                    def backofficeUrl = "http://${params.BACKOFFICE_HOST}:${params.BACKOFFICE_NODE_PORT}"
                    def apiNodePort = params.API_NODE_PORT ?: '31082'
                    def apiGatewayUrl = "http://${params.API_HOST}:${apiNodePort}"
                    def apiExampleUrl = "${apiGatewayUrl}/api/product/storefront/products/featured?pageNo=0"
                    def swaggerUrl = "${apiGatewayUrl}/swagger-ui/"

                    currentBuild.displayName = "#${currentBuild.number} ${env.DEPLOY_NAMESPACE}"
                    currentBuild.description = """
                        <b>Developer URLs</b><br/>
                        <a href="${storefrontUrl}">Storefront</a>: ${storefrontUrl}<br/>
                        <a href="${backofficeUrl}">Backoffice</a>: ${backofficeUrl}<br/>
                        <a href="${swaggerUrl}">Swagger UI</a>: ${swaggerUrl}<br/>
                        <a href="${apiExampleUrl}">API smoke test</a>
                    """.stripIndent().trim()
                }
            }
        }
    }
}
