        [id: 'payment-paypal', param: 'PAYMENT_PAYPAL_BRANCH', chart: 'payment-paypal', release: 'payment-paypal', root: 'backend', image: 'yas-payment-paypal'],
        [id: 'product',        param: 'PRODUCT_BRANCH',        chart: 'product',        release: 'product',        root: 'backend', image: 'yas-product'],
